# ==============================================================================
# Level-Based Community Coding Practice Platform (.env.example)
# Copy this file to server/.env and fill in your values.
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=prac_web
DB_CONNECTION_LIMIT=10

# Authentication (JWT)
JWT_SECRET=replace_this_with_a_secure_random_secret_key_at_least_32_characters
JWT_EXPIRES_IN=7d

# Code Execution Service (Judge0 CE Hosted, RapidAPI, or Self-Hosted)
# Hosted public Judge0 CE instance (no key required): https://ce.judge0.com
# Default self-hosted local instance: http://localhost:2358
# If using RapidAPI Judge0: https://judge0-ce.p.rapidapi.com (requires JUDGE0_API_KEY and JUDGE0_API_HOST)
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# Admin Bootstrap Credentials (Used only by scripts/bootstrap-admin.js)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@pracweb.dev
BOOTSTRAP_ADMIN_PASSWORD=Admin@PracWeb2026!
